</span></span><span class="line"><span class="cl">setfacl -R -m u:spd:rx /home/ops/shared/trading/<span class="o">{</span>PublicInfo,lib,Snail,Spider<span class="o">}</span></span></span></code></pre></td></tr></table>
</div>
